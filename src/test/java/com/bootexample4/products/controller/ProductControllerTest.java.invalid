@Test
@Tag("valid")
public void validProductCreation() {
    
    Product inputProduct = new Product();
    
    inputProduct.setName("Sample Product");
    
    inputProduct.setDescription("Description of sample product");
    
    inputProduct.setPrice(99.99);
    Mockito.when(productRepositoryMock.save(Mockito.any(Product.class))).thenReturn(inputProduct);
    
    Product createdProduct = productController.createProduct(inputProduct);
    
    assertEquals(inputProduct.getName(), createdProduct.getName());
    assertEquals(inputProduct.getDescription(), createdProduct.getDescription());
    assertEquals(inputProduct.getPrice(), createdProduct.getPrice());
}

