@Test
public void handleExceptionDuringCreation() {
    Product product = new Product();
    product.setName("Valid Name");
    product.setDescription("Valid Description");
    product.setPrice(100.0);
    when(productRepository.save(product)).thenThrow(new RuntimeException("Database exception"));
    assertThrows(RuntimeException.class, () -> productController.createProduct(product), "Should throw RuntimeException when repository fails.");
}

