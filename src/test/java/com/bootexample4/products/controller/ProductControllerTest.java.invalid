private Product createProduct(Long id, String name, String description, Double price) {
    Product product = new Product();
    product.setId(id);
    product.setName(name);
    product.setDescription(description);
    if (price != null) {
        product.setPrice(price);
    } else {
        
        product.setPrice(0.0);
    }
    return product;
}

/*ROOST_METHOD_HASH=updateProduct_e220585694
ROOST_METHOD_SIG_HASH=updateProduct_9454a9af90

*/
@BeforeEach
public void setup() {
    
    Mockito.reset(productRepository);
}

/*ROOST_METHOD_HASH=updateProduct_e220585694
ROOST_METHOD_SIG_HASH=updateProduct_9454a9af90

*/
@Test
@Tag("valid")
public void updateExistingProductSuccessfully() {
    
    Long id = 1L;
    Product existingProduct = createProduct(id, "Old Name", "Old Description", 100.0);
    Product updatedProductInput = createProduct(id, "New Name", "New Description", 200.0);
    when(productRepository.findById(id)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(existingProduct)).thenReturn(updatedProductInput);
    
    ResponseEntity<Product> response = productController.updateProduct(id, updatedProductInput);
    
    
    assertEquals((Product) response.getBody(), updatedProductInput);
    assertEquals(response.getStatusCodeValue(), 200);
    verify(productRepository, times(1)).findById(id);
    verify(productRepository, times(1)).save(existingProduct);
}

/*ROOST_METHOD_HASH=updateProduct_e220585694
ROOST_METHOD_SIG_HASH=updateProduct_9454a9af90

