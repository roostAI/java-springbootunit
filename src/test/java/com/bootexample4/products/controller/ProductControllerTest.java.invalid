@Test
public void createProductWithValidInput() {
    Product product = new Product();
    product.setName("Valid Name");
    product.setDescription("Valid Description");
    product.setPrice(100.0);
    when(productRepository.save(product)).thenReturn(product);
    Product result = productController.createProduct(product);
    assertNotNull(result, "Product should not be null.");
    assertEquals(product, result, "Returned product should match input product.");
    verify(productRepository, times(1)).save(product);
}

/*ROOST_METHOD_HASH=createProduct_36b748883e
