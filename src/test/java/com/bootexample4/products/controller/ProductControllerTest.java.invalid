/*ROOST_METHOD_HASH=createProduct_16b670a647
ROOST_METHOD_SIG_HASH=createProduct_36b748883e

*/public void verifyProductCreationWithValidInput() {
    
    Product mockProduct = new Product();
    
    mockProduct.setName("Sample Product");
    
    mockProduct.setDescription("Sample Description");
    
    mockProduct.setPrice(100.0);
    when(productRepository.save(mockProduct)).thenReturn(mockProduct);
    
    Product result = productController.createProduct(mockProduct);
    
    assertThat(result).isNotNull();
    assertThat(result.getName()).isEqualTo(mockProduct.getName());
    assertThat(result.getDescription()).isEqualTo(mockProduct.getDescription());
    assertThat(result.getPrice()).isEqualTo(mockProduct.getPrice());
    verify(productRepository, times(1)).save(mockProduct);
}

