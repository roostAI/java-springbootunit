package com.bootexample4.products.controller;import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.springframework.test.context.junit.jupiter.SpringJUnitConfig;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@SpringJUnitConfig
class ProductControllerCreateProductTest {
    @Mock
    ProductRepository productRepository;
    @InjectMocks
    ProductController productController;
    @BeforeEach
    void setUp() {
        productRepository = mock(ProductRepository.class);
        productController = new ProductController();
        productController.setProductRepository(productRepository); // Use setter method to inject repository
    }
    @Test
    @Tag("valid")
    public void createProductWithValidInput() {
        Product product = new Product();
        product.setName("Valid Name");
        product.setDescription("Valid Description");
        product.setPrice(100.0);
        when(productRepository.save(product)).thenReturn(product);
        Product result = productController.createProduct(product);
        assertNotNull(result, "Product should not be null.");
        assertEquals(product, result, "Returned product should match input product.");
        verify(productRepository, times(1)).save(product);
    }
    @Test
    @Tag("invalid")
    public void handleExceptionDuringCreation() {
        Product product = new Product();
        product.setName("Valid Name");
        product.setDescription("Valid Description");
        product.setPrice(100.0);
        when(productRepository.save(product)).thenThrow(new RuntimeException("Database exception"));
        assertThrows(RuntimeException.class, () -> productController.createProduct(product),
                "Should throw RuntimeException when repository fails.");
    }
    @Test
    @Tag("invalid")
    public void createProductWithNullInput() {
        Product product = null;
        assertThrows(NullPointerException.class, () -> productController.createProduct(product),
                "Should throw NullPointerException when input Product is null.");
    }
    @Test
    @Tag("invalid")
    public void createProductWithEmptyAttributes() {
        Product product = new Product();
        product.setName("");
        product.setDescription("");
        product.setPrice(0.0); // Empty attributes
        when(productRepository.save(product)).thenReturn(product);
        Product result = productController.createProduct(product);
        assertNotNull(result, "Product should not be null.");
        assertEquals(product, result, "Returned product should match input product with empty attributes.");
        verify(productRepository, times(1)).save(product);
    }
    @Test
    @Tag("invalid")
    public void createProductWhenRepositoryNull() {
        productController.setProductRepository(null); // Simulate null repository
        Product product = new Product();
        product.setName("Valid Name");
        product.setDescription("Valid Description");
        product.setPrice(100.0);
        assertThrows(NullPointerException.class, () -> productController.createProduct(product),
                "Should throw NullPointerException when repository is null.");
    }
    @Test
    @Tag("integration")
    public void repositoryInteractionDuringCreation() {
        Product product = new Product();
        product.setName("Valid Name");
        product.setDescription("Valid Description");
        product.setPrice(100.0);
        when(productRepository.save(product)).thenReturn(product);
        Product result = productController.createProduct(product);
        assertEquals(product, result, "Returned product should match input product.");
        verify(productRepository, times(1)).save(product);
    }
    @Test
    @Tag("valid")
    public void checkReturnTypeAfterCreation() {
        Product product = new Product();
        product.setName("Valid Name");
        product.setDescription("Valid Description");
        product.setPrice(100.0);
        when(productRepository.save(product)).thenReturn(product);
        Product result = productController.createProduct(product);
        assertTrue(result instanceof Product, "Returned object should be an instance of Product.");
    }
    @Test
    @Tag("invalid")
    public void repositoryReturnsNullDuringCreation() {
        Product product = new Product();
        product.setName("Valid Name");
        product.setDescription("Valid Description");
        product.setPrice(100.0);
        when(productRepository.save(product)).thenReturn(null);
        Product result = productController.createProduct(product);
        assertNull(result, "Returned product should be null when repository returns null.");
    }
    @Test
    @Tag("boundary")
    public void createProductWithLargePriceValue() {
        Product product = new Product();
        product.setName("Valid Name");
        product.setDescription("Valid Description");
        product.setPrice(Double.MAX_VALUE);
        when(productRepository.save(product)).thenReturn(product);
        Product result = productController.createProduct(product);
        assertNotNull(result, "Returned product should not be null.");
        assertEquals(Double.MAX_VALUE, result.getPrice(), "Returned product's price should match the large price value.");
    }
    @Test
    @Tag("boundary")
    public void createProductWithSpecialCharacters() {
        Product product = new Product();
        product.setName("Name!@#$%^");
        product.setDescription("Description*&^%$");
        product.setPrice(100.0);
        when(productRepository.save(product)).thenReturn(product);
        Product result = productController.createProduct(product);
        assertNotNull(result, "Returned product should not be null.");
        assertEquals("Name!@#$%^", result.getName(), "Product name should match input with special characters.");
        assertEquals("Description*&^%$", result.getDescription(),
                "Product description should match input with special characters.");
    }
}