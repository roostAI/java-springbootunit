@Test
@Tag("integration")
public void getAllProductsReturnsNonEmptyList() {
    
    List<Product> mockProducts = new ArrayList<>();
    
    Product mockProduct1 = new Product();
    mockProduct1.setName("Product 1");
    mockProducts.add(mockProduct1);
    
    Product mockProduct2 = new Product();
    mockProduct2.setName("Product 2");
    mockProducts.add(mockProduct2);
    when(productRepository.findAll()).thenReturn(mockProducts);
    
    List<Product> result = productController.getAllProducts();
    
    assertThat(result).isNotNull();
    assertThat(result.size()).isEqualTo(mockProducts.size());
    assertThat(result).containsAll(mockProducts);
}

