@Test
@Tag("boundary")
public void deleteProductWithDuplicateIds() {
    
    Long duplicateId = 1L;
    Product mockProduct1 = new Product();
    Product mockProduct2 = new Product();
    when(productRepository.findById(duplicateId)).thenReturn(Optional.of(mockProduct1)).thenReturn(Optional.of(mockProduct2));
    ResponseEntity<Object> response1 = productController.deleteProduct(duplicateId);
    verify(productRepository, times(1)).delete(mockProduct1);
    assertEquals(ResponseEntity.ok().build(), response1);
    ResponseEntity<Object> response2 = productController.deleteProduct(duplicateId);
    verify(productRepository, times(1)).delete(mockProduct2);
    assertEquals(ResponseEntity.ok().build(), response2);
}
