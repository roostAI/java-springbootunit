@Test
@Tag("integration")
public void exceptionHandlingDuringDeletion() {
    
    
    Long productId = 5L;
    
    when(productRepository.findById(productId)).thenThrow(new RuntimeException("Database connection error"));
    
    ResponseEntity<Object> response = productController.deleteProduct(productId);
    
    
    assertThat(response.getStatusCode()).isEqualTo(HttpStatus.INTERNAL_SERVER_ERROR);
    verify(productRepository, times(1)).findById(productId);
    verify(productRepository, times(0)).delete(any());
}
