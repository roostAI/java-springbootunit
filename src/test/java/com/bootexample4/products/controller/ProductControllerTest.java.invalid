    existingProduct.setName("OldName");
    existingProduct.setDescription("OldDescription");
    existingProduct.setPrice(50.0);
    Product productWithNullFields = new Product();
    productWithNullFields.setName(null);
    productWithNullFields.setDescription(null);
    
    productWithNullFields.setPrice(0.0);
    when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(existingProduct)).thenReturn(existingProduct);
    
    ResponseEntity<Product> response = productController.updateProduct(productId, productWithNullFields);
    
    assertThat(response.getStatusCodeValue()).isEqualTo(200);
    Product updatedProduct = response.getBody();
    assertThat(updatedProduct.getName()).isNotNull();
    assertThat(updatedProduct.getDescription()).isNotNull();
    assertThat((double) updatedProduct.getPrice()).isNotNull().isGreaterThan(0.0);
}

