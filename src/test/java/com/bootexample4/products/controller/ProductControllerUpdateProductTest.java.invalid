    @Test
    @Tag("integration")
    public void repositoryInteractionDuringUpdateScenario() {
        // Arrange
        Long productId = 1L;
        Product existingProduct = new Product();
        existingProduct.setId(productId);
        existingProduct.setName("Original");
        existingProduct.setDescription("Description");
        existingProduct.setPrice(100.0);
        Product updatedProductDetails = new Product();
        updatedProductDetails.setName("Updated");
        updatedProductDetails.setDescription("Updated Description");
        updatedProductDetails.setPrice(150.0);
        when(mockRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
        when(mockRepository.save(Mockito.any(Product.class))).thenReturn(updatedProductDetails);
        // Act
        productController.updateProduct(productId, updatedProductDetails);
        // Assert
        verify(mockRepository, times(1)).findById(productId);
        verify(mockRepository, times(1)).save(Mockito.any(Product.class));
    }
