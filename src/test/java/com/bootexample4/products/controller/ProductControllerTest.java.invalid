@Test
public void createProductWithSpecialCharacters() {
    Product product = new Product();
    product.setName("Name!@#$%^");
    product.setDescription("Description*&^%$");
    product.setPrice(100.0);
    when(productRepository.save(product)).thenReturn(product);
    Product result = productController.createProduct(product);
    assertNotNull(result, "Returned product should not be null.");
    assertEquals("Name!@#$%^", result.getName(), "Product name should match input with special characters.");
    assertEquals("Description*&^%$", result.getDescription(), "Product description should match input with special characters.");
}
