package com.bootexample4.products.controller;import java.util.List;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import static org.mockito.Mockito.*;
import static org.assertj.core.api.Assertions.*;
import java.math.BigDecimal;
import org.junit.jupiter.api.*;

@ExtendWith(MockitoExtension.class)
public class ProductControllerCreateProductTest {
    @Mock
    private ProductRepository productRepository;
    @InjectMocks
    private ProductController productController;
    private Product validProduct;
    private Product savedProduct;
    
    @BeforeEach
    void setUp() {
        validProduct = new Product();
        validProduct.setName("Test Product");
        validProduct.setDescription("Test Description");
        validProduct.setPrice(new BigDecimal("99.99"));
        savedProduct = new Product();
        savedProduct.setId(1L);
        savedProduct.setName("Test Product");
        savedProduct.setDescription("Test Description");
        savedProduct.setPrice(new BigDecimal("99.99"));
    }
    
    @Test
    @Tag("valid")
    void createProductWithValidData() {
        // Arrange
        when(productRepository.save(validProduct)).thenReturn(savedProduct);
        // Act
        Product result = productController.createProduct(validProduct);
        // Assert
        assertThat(result).isNotNull();
        assertThat(result.getId()).isEqualTo(1L);
        assertThat(result.getName()).isEqualTo("Test Product");
        assertThat(result.getDescription()).isEqualTo("Test Description");
        assertThat(result.getPrice()).isEqualByComparingTo(new BigDecimal("99.99"));
        verify(productRepository, times(1)).save(validProduct);
    }
    
    @Test
    @Tag("invalid")
    void createProductWithNullProduct() {
        // Arrange
        Product nullProduct = null;
        when(productRepository.save(nullProduct)).thenThrow(new IllegalArgumentException("Product cannot be null"));
        // Act & Assert
        assertThatThrownBy(() -> productController.createProduct(nullProduct))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessage("Product cannot be null");
        verify(productRepository, times(1)).save(nullProduct);
    }
    
    @Test
    @Tag("invalid")
    void createProductWithRepositorySaveException() {
        // Arrange
        when(productRepository.save(validProduct)).thenThrow(new RuntimeException("Database connection failed"));
        // Act & Assert
        assertThatThrownBy(() -> productController.createProduct(validProduct))
                .isInstanceOf(RuntimeException.class)
                .hasMessage("Database connection failed");
        verify(productRepository, times(1)).save(validProduct);
    }
    
    @Test
    @Tag("boundary")
    void createProductWithEmptyFields() {
        // Arrange
        Product emptyProduct = new Product();
        emptyProduct.setName("");
        emptyProduct.setDescription("");
        emptyProduct.setPrice(BigDecimal.ZERO);
        Product savedEmptyProduct = new Product();
        savedEmptyProduct.setId(2L);
        savedEmptyProduct.setName("");
        savedEmptyProduct.setDescription("");
        savedEmptyProduct.setPrice(BigDecimal.ZERO);
        when(productRepository.save(emptyProduct)).thenReturn(savedEmptyProduct);
        // Act
        Product result = productController.createProduct(emptyProduct);
        // Assert
        assertThat(result).isNotNull();
        assertThat(result.getId()).isEqualTo(2L);
        assertThat(result.getName()).isEmpty();
        assertThat(result.getDescription()).isEmpty();
        assertThat(result.getPrice()).isEqualByComparingTo(BigDecimal.ZERO);
        verify(productRepository, times(1)).save(emptyProduct);
    }
    
    @Test
    @Tag("integration")
    void createProductVerifyRepositoryInteraction() {
        // Arrange
        when(productRepository.save(validProduct)).thenReturn(savedProduct);
        // Act
        Product result = productController.createProduct(validProduct);
        // Assert
        assertThat(result).isNotNull();
        verify(productRepository, times(1)).save(validProduct);
        verifyNoMoreInteractions(productRepository);
    }
    
    @Test
    @Tag("boundary")
    void createProductWithLargeDataValues() {
        // Arrange
        String longName = "A".repeat(1000);
        String longDescription = "B".repeat(5000);
        BigDecimal largePrice = new BigDecimal("999999999.99");
        Product largeProduct = new Product();
        largeProduct.setName(longName);
        largeProduct.setDescription(longDescription);
        largeProduct.setPrice(largePrice);
        Product savedLargeProduct = new Product();
        savedLargeProduct.setId(3L);
        savedLargeProduct.setName(longName);
        savedLargeProduct.setDescription(longDescription);
        savedLargeProduct.setPrice(largePrice);
        when(productRepository.save(largeProduct)).thenReturn(savedLargeProduct);
        // Act
        Product result = productController.createProduct(largeProduct);
        // Assert
        assertThat(result).isNotNull();
        assertThat(result.getId()).isEqualTo(3L);
        assertThat(result.getName()).hasSize(1000);
        assertThat(result.getDescription()).hasSize(5000);
        assertThat(result.getPrice()).isEqualByComparingTo(largePrice);
        assertThat(result.getName()).isEqualTo(longName);
        assertThat(result.getDescription()).isEqualTo(longDescription);
        verify(productRepository, times(1)).save(largeProduct);
    }
    
    @Test
    @Tag("boundary")
    void createProductWithNullFields() {
        // Arrange
        Product productWithNullFields = new Product();
        productWithNullFields.setName(null);
        productWithNullFields.setDescription(null);
        productWithNullFields.setPrice(null);
        Product savedProductWithNullFields = new Product();
        savedProductWithNullFields.setId(4L);
        savedProductWithNullFields.setName(null);
        savedProductWithNullFields.setDescription(null);
        savedProductWithNullFields.setPrice(null);
        when(productRepository.save(productWithNullFields)).thenReturn(savedProductWithNullFields);
        // Act
        Product result = productController.createProduct(productWithNullFields);
        // Assert
        assertThat(result).isNotNull();
        assertThat(result.getId()).isEqualTo(4L);
        assertThat(result.getName()).isNull();
        assertThat(result.getDescription()).isNull();
        assertThat(result.getPrice()).isNull();
        verify(productRepository, times(1)).save(productWithNullFields);
    }
    
    @Test
    @Tag("boundary")
    void createProductWithNegativePrice() {
        // Arrange
        Product negativeProduct = new Product();
        negativeProduct.setName("Negative Price Product");
        negativeProduct.setDescription("Product with negative price");
        negativeProduct.setPrice(new BigDecimal("-50.00"));
        Product savedNegativeProduct = new Product();
        savedNegativeProduct.setId(5L);
        savedNegativeProduct.setName("Negative Price Product");
        savedNegativeProduct.setDescription("Product with negative price");
        savedNegativeProduct.setPrice(new BigDecimal("-50.00"));
        when(productRepository.save(negativeProduct)).thenReturn(savedNegativeProduct);
        // Act
        Product result = productController.createProduct(negativeProduct);
        // Assert
        assertThat(result).isNotNull();
        assertThat(result.getId()).isEqualTo(5L);
        assertThat(result.getPrice()).isEqualByComparingTo(new BigDecimal("-50.00"));
        verify(productRepository, times(1)).save(negativeProduct);
    }
}