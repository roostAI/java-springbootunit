@BeforeEach
public void setUp() {
    mockProduct = new Product();
    
    mockProduct.setId(1L);
    mockProduct.setName("Test Product");
    mockProduct.setDescription("Test Description");
    
    mockProduct.setPrice(100.0);
}

/*ROOST_METHOD_HASH=getProductById_a31a3ac160
ROOST_METHOD_SIG_HASH=getProductById_d22f3ea272

*/
@Test
@Tag("valid")
public void validProductIdReturnsProduct() {
    
    
    Long validProductId = 1L;
    when(productRepository.findById(validProductId)).thenReturn(Optional.of(mockProduct));
    
    ResponseEntity<Product> response = productController.getProductById(validProductId);
    
    assertThat(response.getStatusCode().value()).isEqualTo(200);
    assertThat(response.getBody()).isNotNull();
    assertThat(response.getBody().getId()).isEqualTo(mockProduct.getId());
    assertThat(response.getBody().getName()).isEqualTo(mockProduct.getName());
    assertThat(response.getBody().getDescription()).isEqualTo(mockProduct.getDescription());
    assertThat((Double) response.getBody().getPrice()).isEqualTo((Double) mockProduct.getPrice());
}

