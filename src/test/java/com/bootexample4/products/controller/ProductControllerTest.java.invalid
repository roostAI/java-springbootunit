@Test
@Tag("boundary")
public void updateProductWithEdgeCasePrice() {
    
    Long productId = 1L;
    Product existingProduct = new Product();
    existingProduct.setName("OldEdges");
    existingProduct.setDescription("OldEdgeDescription");
    existingProduct.setPrice(5.0);
    Product newProductDetails = new Product();
    newProductDetails.setName("NewEdges");
    newProductDetails.setDescription("NewEdgeDescription");
    newProductDetails.setPrice(Double.MAX_VALUE);
    when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(existingProduct)).thenReturn(newProductDetails);
    
    ResponseEntity<Product> response = productController.updateProduct(productId, newProductDetails);
    
    assertThat(response.getStatusCodeValue()).isEqualTo(200);
    Product updatedProduct = response.getBody();
    assertThat(updatedProduct.getName()).isEqualTo("NewEdges");
    assertThat(updatedProduct.getDescription()).isEqualTo("NewEdgeDescription");
    assertThat((double) updatedProduct.getPrice()).isEqualTo(Double.MAX_VALUE);
}

