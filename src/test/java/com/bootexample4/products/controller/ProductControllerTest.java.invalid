@Test
@Tag("boundary")
public void testConfirmNullHandlingInProductsList() {
    
    Product productWithNullFields = new Product();
    List<Product> predefinedProductsListWithNulls = Collections.singletonList(productWithNullFields);
    Mockito.when(productRepository.findAll()).thenReturn(predefinedProductsListWithNulls);
    List<Product> actualProductsList = productController.getAllProducts();
    
    assertEquals(1, actualProductsList.size(), "The list size should match the predefined list.");
    assertEquals(null, actualProductsList.get(0).getName(), "Product name should be null as predefined.");
    assertEquals(null, actualProductsList.get(0).getDescription(), "Product description should be null as predefined.");
    assertEquals(0.0, actualProductsList.get(0).getPrice(), "Product price should be 0.0 as default.");
}

