/*ROOST_METHOD_HASH=updateProduct_e220585694
ROOST_METHOD_SIG_HASH=updateProduct_9454a9af90

*/public void updateExistingProduct() {
    
    
    Long productId = 1L;
    Product existingProduct = new Product();
    existingProduct.setName("Old Name");
    existingProduct.setDescription("Old Description");
    existingProduct.setPrice(100.00);
    Product updatedProductInput = new Product();
    updatedProductInput.setName("New Name");
    updatedProductInput.setDescription("New Description");
    updatedProductInput.setPrice(150.00);
    when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(any(Product.class))).thenReturn(updatedProductInput);
    
    ResponseEntity<Product> response = productController.updateProduct(productId, updatedProductInput);
    
    assertEquals(ResponseEntity.ok(updatedProductInput), response);
}

/*ROOST_METHOD_HASH=updateProduct_e220585694
ROOST_METHOD_SIG_HASH=updateProduct_9454a9af90

*/public void updateNonExistentProduct() {
    
    
    Long productId = 999L;
    Product updatedProductInput = new Product();
    updatedProductInput.setName("New Name");
    updatedProductInput.setDescription("New Description");
    updatedProductInput.setPrice(150.00);
    when(productRepository.findById(productId)).thenReturn(Optional.empty());
    
    ResponseEntity<Product> response = productController.updateProduct(productId, updatedProductInput);
    
    assertEquals(ResponseEntity.notFound().build(), response);
}

/*ROOST_METHOD_HASH=updateProduct_e220585694
ROOST_METHOD_SIG_HASH=updateProduct_9454a9af90

*/public void updateProductWithNullFields() {
    
    
    Long productId = 1L;
    Product existingProduct = new Product();
    existingProduct.setName("Old Name");
    existingProduct.setDescription("Old Description");
    existingProduct.setPrice(100.00);
    
    Product updatedProductInput = new Product();
    when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(any(Product.class))).thenReturn(existingProduct);
    
    ResponseEntity<Product> response = productController.updateProduct(productId, updatedProductInput);
    
    Product updatedProduct = response.getBody();
    assertEquals(null, updatedProduct.getName());
    assertEquals(null, updatedProduct.getDescription());
    
    assertEquals(0.0, updatedProduct.getPrice());
}

