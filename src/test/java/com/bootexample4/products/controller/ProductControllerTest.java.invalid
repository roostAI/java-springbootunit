@Test
@Tag("integration")
public void concurrentIdAccessReturnsConsistentResults() {
    
    Product mockProduct = new Product();
    mockProduct.setName("Concurrent Product");
    mockProduct.setDescription("Concurrent Description");
    mockProduct.setPrice(200.0);
    mockProduct.setId(1L);
    Mockito.when(productRepository.findById(1L)).thenReturn(Optional.of(mockProduct));
    Runnable action = () -> {
        ResponseEntity<Product> response = productController.getProductById(1L);
        assertEquals(mockProduct, response.getBody());
    };
    
    Thread thread1 = new Thread(action);
    Thread thread2 = new Thread(action);
    thread1.start();
    thread2.start();
    
    
}

