@Test
@Tag("valid")
public void updateProductWithValidIdAndDetails() {
    
    Long productId = 1L;
    Product existingProduct = new Product();
    existingProduct.setName("OldName");
    existingProduct.setDescription("OldDescription");
    existingProduct.setPrice(50.0);
    Product newProductDetails = new Product();
    newProductDetails.setName("NewName");
    newProductDetails.setDescription("NewDescription");
    newProductDetails.setPrice(100.0);
    when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
    when(productRepository.save(existingProduct)).thenReturn(newProductDetails);
    
    ResponseEntity<Product> response = productController.updateProduct(productId, newProductDetails);
    
    assertThat(response.getStatusCodeValue()).isEqualTo(200);
    Product updatedProduct = response.getBody();
    assertThat(updatedProduct.getName()).isEqualTo("NewName");
    assertThat(updatedProduct.getDescription()).isEqualTo("NewDescription");
    assertThat((double) updatedProduct.getPrice()).isEqualTo(100.0);
}

