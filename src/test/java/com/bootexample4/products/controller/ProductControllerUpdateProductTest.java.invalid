    @Test
    @Tag("integration")
    void updateProductRepositorySaveOperationSuccess() {
        // Arrange
        Long productId = 1L;
        Product savedProduct = new Product();
        savedProduct.setName("Updated Product");
        savedProduct.setDescription("Updated Description");
        savedProduct.setPrice(new BigDecimal("150.00"));
        
        when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
        when(productRepository.save(existingProduct)).thenReturn(savedProduct);
        // Act
        ResponseEntity<Product> response = productController.updateProduct(productId, updateProduct);
        // Assert
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertNotNull(response.getBody());
        assertEquals(savedProduct, response.getBody());
        verify(productRepository, times(1)).save(existingProduct);
        verify(productRepository).findById(productId);
    }
    @Test
    @Tag("valid")
    void updateProductFieldAssignmentVerification() {
        // Arrange
        Long productId = 1L;
        when(productRepository.findById(productId)).thenReturn(Optional.of(existingProduct));
        when(productRepository.save(any(Product.class))).thenAnswer(invocation -> {
            Product productToSave = invocation.getArgument(0);
            assertEquals("Updated Product", productToSave.getName());
            assertEquals("Updated Description", productToSave.getDescription());
            assertEquals(0, new BigDecimal("150.00").compareTo(productToSave.getPrice()));
            return productToSave;
        });
        // Act
        ResponseEntity<Product> response = productController.updateProduct(productId, updateProduct);
        // Assert
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertNotNull(response.getBody());
        verify(productRepository).findById(productId);
        verify(productRepository).save(existingProduct);
    }
    @Test
    @Tag("valid")
    void updateProductResponseEntityStructureValidation() {
        // Arrange - Test successful update
        Long existingProductId = 1L;
        when(productRepository.findById(existingProductId)).thenReturn(Optional.of(existingProduct));
        when(productRepository.save(any(Product.class))).thenReturn(existingProduct);
        // Act - Test successful update
        ResponseEntity<Product> successResponse = productController.updateProduct(existingProductId, updateProduct);
        // Assert - Verify successful response structure
        assertEquals(HttpStatus.OK, successResponse.getStatusCode());
        assertNotNull(successResponse.getBody());
        assertTrue(successResponse.hasBody());
        // Arrange - Test not found scenario
        Long nonExistentId = 999L;
        when(productRepository.findById(nonExistentId)).thenReturn(Optional.empty());
        // Act - Test not found scenario
        ResponseEntity<Product> notFoundResponse = productController.updateProduct(nonExistentId, updateProduct);
        // Assert - Verify not found response structure
        assertEquals(HttpStatus.NOT_FOUND, notFoundResponse.getStatusCode());
        assertNull(notFoundResponse.getBody());
        assertFalse(notFoundResponse.hasBody());
    }
