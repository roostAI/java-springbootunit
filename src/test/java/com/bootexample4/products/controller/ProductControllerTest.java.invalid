@Test
@Tag("integration")
public void getProductByIdWithConcurrentRequests() {
    
    Long validId = 10L;
    Product mockProduct = new Product();
    mockProduct.setId(validId);
    mockProduct.setName("Test Product");
    mockProduct.setDescription("Description");
    mockProduct.setPrice(100.0);
    when(productRepository.findById(validId)).thenReturn(Optional.of(mockProduct));
    Runnable task = () -> {
        ResponseEntity<Product> response = productController.getProductById(validId);
        assertThat(response.getStatusCodeValue()).isEqualTo(200);
        assertThat(response.getBody()).isNotNull();
        assertThat(response.getBody().getName()).isEqualTo(mockProduct.getName());
        assertThat(response.getBody().getDescription()).isEqualTo(mockProduct.getDescription());
        assertThat(response.getBody().getPrice()).isEqualTo(mockProduct.getPrice());
    };
    Thread thread1 = new Thread(task);
    Thread thread2 = new Thread(task);
    thread1.start();
    thread2.start();
}

