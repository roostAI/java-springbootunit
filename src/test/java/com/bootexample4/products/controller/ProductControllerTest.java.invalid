    List<Product> result = productController.getAllProducts();
    
    Assertions.assertThat(result).isNotNull();
    Assertions.assertThat(result.size()).isEqualTo(mockProducts.size());
    Assertions.assertThat(result).containsExactlyElementsOf(mockProducts);
}

