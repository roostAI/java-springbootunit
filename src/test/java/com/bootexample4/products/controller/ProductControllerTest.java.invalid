@Test
@Tag("boundary")
public void getProductByIdWithBoundaryValues() {
    
    when(productRepository.findById(Long.MIN_VALUE)).thenReturn(Optional.empty());
    
    ResponseEntity<Product> minResponse = productController.getProductById(Long.MIN_VALUE);
    
    assertThat(minResponse.getStatusCodeValue()).isEqualTo(404);
    
    when(productRepository.findById(Long.MAX_VALUE)).thenReturn(Optional.empty());
    
    ResponseEntity<Product> maxResponse = productController.getProductById(Long.MAX_VALUE);
    
    assertThat(maxResponse.getStatusCodeValue()).isEqualTo(404);
}

