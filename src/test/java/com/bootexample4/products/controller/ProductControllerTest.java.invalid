@Test
@Tag("integration")
public void getAllProductsReturnsMultipleProducts() {
    
    
    Product product1 = new Product();
    product1.setName("Product1");
    product1.setDescription("Description1");
    product1.setPrice(100.0);
    
    Product product2 = new Product();
    product2.setName("Product2");
    product2.setDescription("Description2");
    product2.setPrice(150.0);
    List<Product> mockProducts = Arrays.asList(product1, product2);
    when(productRepository.findAll()).thenReturn(mockProducts);
    
    List<Product> actualProducts = productController.getAllProducts();
    
    assertNotNull(actualProducts, "Returned products list should not be null");
    assertEquals(2, actualProducts.size(), "The size of returned products does not match the mocked size");
    assertEquals(mockProducts.get(0), actualProducts.get(0), "First product does not match the mocked product");
    assertEquals(mockProducts.get(1), actualProducts.get(1), "Second product does not match the mocked product");
}

