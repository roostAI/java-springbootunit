@Test
@Tag("valid")
public void validateProductListIntegrity() {
    
    Product product1 = new Product();
    product1.setId(1L);
    product1.setName("Product1");
    product1.setDescription("Description1");
    product1.setPrice(100.0);
    Product product2 = new Product();
    product2.setId(2L);
    product2.setName("Product2");
    product2.setDescription("Description2");
    product2.setPrice(200.0);
    List<Product> mockProducts = Arrays.asList(product1, product2);
    Mockito.when(productRepository.findAll()).thenReturn(mockProducts);
    
    List<Product> result = productController.getAllProducts();
    
    Assertions.assertThat(result).isNotNull();
    Assertions.assertThat(result).hasSize(mockProducts.size());
    for (int i = 0; i < result.size(); i++) {
        Assertions.assertThat(result.get(i).getId()).isEqualTo(mockProducts.get(i).getId());
        Assertions.assertThat(result.get(i).getName()).isEqualTo(mockProducts.get(i).getName());
        Assertions.assertThat(result.get(i).getDescription()).isEqualTo(mockProducts.get(i).getDescription());
        Assertions.assertThat(result.get(i).getPrice()).isEqualTo(mockProducts.get(i).getPrice());
    }
}

