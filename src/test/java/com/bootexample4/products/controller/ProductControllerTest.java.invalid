/*ROOST_METHOD_HASH=deleteProduct_5ea3a876a4
ROOST_METHOD_SIG_HASH=deleteProduct_dcaff736d4

*/public void deleteProductSuccessfully() {
    
    Long existingProductId = 1L;
    
    Product mockProduct = new Product();
    Mockito.when(productRepository.findById(existingProductId)).thenReturn(Optional.of(mockProduct));
    
    ResponseEntity<Object> response = productController.deleteProduct(existingProductId);
    
    verify(productRepository, times(1)).delete(mockProduct);
    
    assertThat((int) response.getStatusCodeValue()).isEqualTo(200);
}

/*ROOST_METHOD_HASH=deleteProduct_5ea3a876a4
ROOST_METHOD_SIG_HASH=deleteProduct_dcaff736d4

*/public void deleteProductNotFound() {
    
    
    Long nonExistentProductId = 99L;
    Mockito.when(productRepository.findById(nonExistentProductId)).thenReturn(Optional.empty());
    
    ResponseEntity<Object> response = productController.deleteProduct(nonExistentProductId);
    
    verify(productRepository, never()).delete(any());
    
    assertThat((int) response.getStatusCodeValue()).isEqualTo(404);
}

/*ROOST_METHOD_HASH=deleteProduct_5ea3a876a4
ROOST_METHOD_SIG_HASH=deleteProduct_dcaff736d4

*/public void deleteProductWithNullId() {
    
    Long nullId = null;
    
    ResponseEntity<Object> response = null;
    try {
        
        response = productController.deleteProduct(nullId);
    } catch (Exception e) {
        
        assertThat(e).isInstanceOf(NullPointerException.class);
    }
    
    verify(productRepository, never()).findById(any());
    verify(productRepository, never()).delete(any());
    assertThat(response).isNull();
}
