package com.bootexample4.products.controller;import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mockito;
import org.springframework.beans.factory.annotation.Autowired;
import static org.assertj.core.api.Assertions.assertThat;
import org.junit.jupiter.api.*;
import java.util.List;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

class ProductControllerCreateProductTest {
    @Autowired
    private ProductRepository productRepository;
    @Test
    @Tag("valid")
    public void validProductCreation() {
        // Arrange
        Product validProduct = new Product();
        validProduct.setName("Test Product"); 
        validProduct.setDescription("Test Product Description"); 
        validProduct.setPrice(100.0); 
        Mockito.when(productRepository.save(validProduct)).thenReturn(validProduct);
        ProductController productController = Mockito.spy(ProductController.class);
        Mockito.doReturn(productRepository).when(productController).getProductRepository(); // Workaround for private access
        
        // Act
        Product resultProduct = productController.createProduct(validProduct);
        
        // Assert
        assertThat(resultProduct).isNotNull();
        assertThat((String) resultProduct.getName()).isEqualTo(validProduct.getName());
        assertThat((String) resultProduct.getDescription()).isEqualTo(validProduct.getDescription());
        assertThat((double) resultProduct.getPrice()).isEqualTo(validProduct.getPrice());
    }
    @Test
    @Tag("invalid")
    public void invalidProductCreationNullInput() {
        // Arrange
        Product invalidProduct = null;
        Mockito.when(productRepository.save(invalidProduct)).thenThrow(IllegalArgumentException.class);
        ProductController productController = Mockito.spy(ProductController.class);
        Mockito.doReturn(productRepository).when(productController).getProductRepository(); // Workaround for private access
        
        // Act & Assert
        try {
            productController.createProduct(invalidProduct);
        } catch (IllegalArgumentException ex) {
            assertThat(ex).isInstanceOf(IllegalArgumentException.class);
        }
    }
    @Test
    @Tag("boundary")
    public void boundaryProductCreationEmptyFields() {
        // Arrange
        Product boundaryProduct = new Product();
        boundaryProduct.setName(""); 
        boundaryProduct.setDescription(""); 
        boundaryProduct.setPrice(0.0); 
        Mockito.when(productRepository.save(boundaryProduct)).thenReturn(boundaryProduct);
        ProductController productController = Mockito.spy(ProductController.class);
        Mockito.doReturn(productRepository).when(productController).getProductRepository(); // Workaround for private access
        
        // Act
        Product resultProduct = productController.createProduct(boundaryProduct);
        
        // Assert
        assertThat(resultProduct).isNotNull();
        assertThat((String) resultProduct.getName()).isEqualTo(boundaryProduct.getName());
        assertThat((String) resultProduct.getDescription()).isEqualTo(boundaryProduct.getDescription());
        assertThat((double) resultProduct.getPrice()).isEqualTo(boundaryProduct.getPrice());
    }
}