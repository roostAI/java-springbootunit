package com.bootexample4.products.controller;import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import org.springframework.beans.factory.annotation.Autowired;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import java.util.List;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

class ProductControllerCreateProductTest {
    @Autowired
    private ProductRepository productRepository;
    @Test
    @Tag("valid")
    public void createProductWithValidDetails() {
        Product validProduct = new Product();
        validProduct.setName("Test Product");
        validProduct.setDescription("This is a test product");
        validProduct.setPrice(100.0);
        when(productRepository.save(validProduct)).thenReturn(validProduct);
        ProductController productController = Mockito.spy(ProductController.class);
        productController.setProductRepository(productRepository); // Use setter method
        Product createdProduct = productController.createProduct(validProduct);
        assertEquals(validProduct, createdProduct);
        verify(productRepository, times(1)).save(validProduct);
    }
    @Test
    @Tag("invalid")
    public void createProductWithMissingFields() {
        Product invalidProduct = new Product();
        invalidProduct.setName(null); // Missing name
        invalidProduct.setDescription(null); // Missing description
        invalidProduct.setPrice(0.0); // Default value added for test compatibility
        doThrow(new IllegalArgumentException("Required fields are missing"))
                .when(productRepository).save(invalidProduct);
        ProductController productController = Mockito.spy(ProductController.class);
        productController.setProductRepository(productRepository); // Use setter method
        IllegalArgumentException exception = assertThrows(IllegalArgumentException.class, () -> {
            productController.createProduct(invalidProduct);
        });
        assertEquals("Required fields are missing", exception.getMessage());
        verify(productRepository, never()).save(invalidProduct);
    }
    @Test
    @Tag("invalid")
    public void createProductWithNegativePrice() {
        Product negativePriceProduct = new Product();
        negativePriceProduct.setName("Test Product");
        negativePriceProduct.setDescription("This is a test product");
        negativePriceProduct.setPrice(-50.0); // Negative price
        doThrow(new IllegalArgumentException("Price must be non-negative"))
                .when(productRepository).save(negativePriceProduct);
        ProductController productController = Mockito.spy(ProductController.class);
        productController.setProductRepository(productRepository); // Use setter method
        IllegalArgumentException exception = assertThrows(IllegalArgumentException.class, () -> {
            productController.createProduct(negativePriceProduct);
        });
        assertEquals("Price must be non-negative", exception.getMessage());
        verify(productRepository, never()).save(negativePriceProduct);
    }
    @Test
    @Tag("invalid")
    public void createProductWithNullInput() {
        ProductController productController = Mockito.spy(ProductController.class);
        productController.setProductRepository(productRepository); // Use setter method
        assertThrows(NullPointerException.class, () -> productController.createProduct(null));
        verify(productRepository, never()).save(any());
    }
    @Test
    @Tag("invalid")
    public void createProductWhenRepositoryFails() {
        Product validProduct = new Product();
        validProduct.setName("Test Product");
        validProduct.setDescription("This is a test product");
        validProduct.setPrice(100.0);
        doThrow(new RuntimeException("Repository save failed"))
                .when(productRepository).save(validProduct);
        ProductController productController = Mockito.spy(ProductController.class);
        productController.setProductRepository(productRepository); // Use setter method
        RuntimeException exception = assertThrows(RuntimeException.class, () -> {
            productController.createProduct(validProduct);
        });
        assertEquals("Repository save failed", exception.getMessage());
        verify(productRepository, times(1)).save(validProduct);
    }
    @Test
    @Tag("valid")
    public void createDuplicateProduct() {
        Product duplicateProduct = new Product();
        duplicateProduct.setName("Duplicate Product");
        duplicateProduct.setDescription("Same description as another");
        duplicateProduct.setPrice(200.0);
        when(productRepository.save(duplicateProduct)).thenReturn(duplicateProduct);
        ProductController productController = Mockito.spy(ProductController.class);
        productController.setProductRepository(productRepository); // Use setter method
        Product createdProduct = productController.createProduct(duplicateProduct);
        assertEquals(duplicateProduct, createdProduct);
        verify(productRepository, times(1)).save(duplicateProduct);
    }
    @Test
    @Tag("integration")
    public void logProductCreationAction() {
        Product validProduct = new Product();
        validProduct.setName("Log Test Product");
        validProduct.setDescription("Log testing");
        validProduct.setPrice(300.0);
        when(productRepository.save(validProduct)).thenReturn(validProduct);
        ProductController productController = Mockito.spy(ProductController.class);
        productController.setProductRepository(productRepository); // Use setter method
        Product createdProduct = productController.createProduct(validProduct);
        assertEquals(validProduct, createdProduct);
        verify(productRepository, times(1)).save(validProduct);
        // TODO: Verify logs if logging framework is available
    }
    @Test
    @Tag("boundary")
    public void createProductWithTruncatedFields() {
        Product truncatedProduct = new Product();
        truncatedProduct.setName("x".repeat(256)); // Exceeding length limit if valid
        truncatedProduct.setDescription("x".repeat(1025)); // Exceeding description limit
        truncatedProduct.setPrice(500.0);
        doThrow(new IllegalArgumentException("Field exceeds length limit"))
                .when(productRepository).save(truncatedProduct);
        ProductController productController = Mockito.spy(ProductController.class);
        productController.setProductRepository(productRepository); // Use setter method
        IllegalArgumentException exception = assertThrows(IllegalArgumentException.class, () -> {
            productController.createProduct(truncatedProduct);
        });
        assertEquals("Field exceeds length limit", exception.getMessage());
        verify(productRepository, never()).save(truncatedProduct);
