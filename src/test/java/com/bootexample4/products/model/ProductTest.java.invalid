public void retrieveDescriptionForMultipleProductInstances() {
    
    Product product1 = new Product();
    Product product2 = new Product();
    
    String description1 = "Description One";
    
    String description2 = "Description Two";
    product1.setDescription(description1);
    product2.setDescription(description2);
    
    String actualDescription1 = product1.getDescription();
    String actualDescription2 = product2.getDescription();
    
    assertEquals(description1, actualDescription1);
    assertEquals(description2, actualDescription2);
}

