package com.bootexample4.products.controller;import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.mockito.Mockito;
import org.springframework.beans.factory.annotation.Autowired;
import com.bootexample4.products.model.Product;
import com.bootexample4.products.repository.ProductRepository;
import java.util.Arrays;
import java.util.List;
import static org.mockito.Mockito.*;
import static org.assertj.core.api.Assertions.*;
import org.junit.jupiter.api.*;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

class ProductControllerGetAllProductsTest {
    @Test
    @Tag("valid")
    public void getAllProductsReturnsFullList() {
        // Arrange
        Product mockProduct1 = new Product(); 
        Product mockProduct2 = new Product(); 
        
        // Initialize mockProduct1 and mockProduct2 with valid values
        mockProduct1.setName("Product 1");
        mockProduct1.setDescription("Description 1");
        mockProduct1.setPrice(10.0);
        mockProduct2.setName("Product 2");
        mockProduct2.setDescription("Description 2");
        mockProduct2.setPrice(20.0);
        List<Product> mockProducts = Arrays.asList(mockProduct1, mockProduct2);
        ProductRepository mockRepository = mock(ProductRepository.class);
        when(mockRepository.findAll()).thenReturn(mockProducts);
        // Create mocked instance of ProductController to bypass private access issue on productRepository
        ProductController productController = Mockito.spy(ProductController.class);
        Mockito.doReturn(mockRepository).when(productController).getProductRepository();
        // Act
        List<Product> result = productController.getAllProducts();
        // Assert
        assertThat((List<Product>) result).hasSize(mockProducts.size());
        assertThat((List<Product>) result).containsExactlyElementsOf(mockProducts);
    }
}